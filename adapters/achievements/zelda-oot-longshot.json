    { "id": "kokiri_sword", "name": "Hero of the Forest", "desc": "Find the Kokiri Sword.", "name_zh": "森林里的勇者", "desc_zh": "找到科奇里之剑。", "rule": { "type": "flag", "name": "IsGet.Weapon_Sword_Kokiri" } },
    { "id": "fairy_ocarina", "name": "A Parting Gift", "desc": "Receive the Fairy Ocarina.", "name_zh": "临别的礼物", "desc_zh": "得到妖精之笛。", "rule": { "type": "flag", "name": "IsGet.Item_Ocarina_Fairy" } },
    { "id": "zeldas_lullaby", "name": "Royal Melody", "desc": "Learn Zelda's Lullaby.", "name_zh": "王家的旋律", "desc_zh": "学会塞尔达摇篮曲。", "rule": { "type": "flag", "name": "IsGet.Item_Melody_ZeldaLullaby" } },
    { "id": "kokiri_emerald", "name": "Spiritual Stone of the Forest", "desc": "Obtain the Kokiri Emerald.", "name_zh": "森林的精灵石", "desc_zh": "得到科奇里翡翠。", "rule": { "type": "flag", "name": "IsGet.Item_Stone_Forest" } },
    { "id": "goron_ruby", "name": "Spiritual Stone of Fire", "desc": "Obtain the Goron Ruby.", "name_zh": "火焰的精灵石", "desc_zh": "得到鼓隆红宝石。", "rule": { "type": "flag", "name": "IsGet.Item_Stone_Fire" } },
