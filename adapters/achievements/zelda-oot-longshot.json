    { "id": "spiritual_stones", "name": "Three Spiritual Stones", "desc": "Hold all three Spiritual Stones.", "name_zh": "三颗精灵石", "desc_zh": "集齐三颗精灵石。", "rule": { "type": "count", "names": ["IsGet.Item_Stone_Forest", "IsGet.Item_Stone_Fire", "IsGet.Item_Stone_Water"], "target": 3 } },
