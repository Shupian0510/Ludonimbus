{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ludonimbus",
  "version": "0.6.0",
  "identifier": "io.github.shupian0510.ludonimbus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ludonimbus",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "backgroundColor": "#171a21"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Shupian0510",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ludonimbus-run",
      "binaries/ludusavi"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "resources": {
      "licenses/*": "licenses/",
      "plugin/ludonimbus.star": "millennium/ludonimbus.star"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NUY4Qjk5OUJGNkZDQjgKUldTNC9QYWJtWXRmbVRpWjlFOU9OcTNNUy9YWEVLK2UrOWxvT2RoUEVabmlQVHhISmRTa0ZxMS8K",
      "endpoints": [
        "https://github.com/Shupian0510/Ludonimbus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
