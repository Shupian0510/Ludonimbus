{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ludonimbus",
  "version": "0.1.0",
  "identifier": "io.github.shupian0510.ludonimbus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ludonimbus",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "backgroundColor": "#171a21"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ludonimbus-run", "binaries/ludusavi"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
